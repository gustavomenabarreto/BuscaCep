unit BuscaCep.Services;

interface
 uses BuscaCep.Repository, Busca.Cep.ViaCep.Model;

 Type
   IBuscaCepServices = interface
     ['{855BAA7D-78EA-4334-BD62-B10E09D6A4BA}']

     Function GetCep(ACep: String):TListViacep;
   end;

   TBuscaCepServices = class(TInterfacedObject, IBuscaCepServices)
    Private
     FBuscaCepRepository: IBuscaCepRepository<TListViacep>;
    Public
    constructor Create(BuscaCepRepository: IBuscaCepRepository<TListViacep>);
    Function GetCep(ACep: String): TListViacep;
    procedure SetTipoBusca(ATipoBusca: TTipoBusca);
   end;

implementation

{ TBuscaCepServices }

constructor TBuscaCepServices.Create(BuscaCepRepository: IBuscaCepRepository<TListViacep>);
begin
  FBuscaCepRepository := BuscaCepRepository;
end;

function TBuscaCepServices.GetCep(ACep: String): TListViacep;
begin
   //Patterns Services - Aqui pode conter alguma logica de  negocios, antes de devolver o Json para o client
   Result := FBuscaCepRepository.GetCep(ACep);
end;

procedure TBuscaCepServices.SetTipoBusca(ATipoBusca: TTipoBusca);
begin
  FBuscaCepRepository.TipoBusca := ATipoBusca;
end;

end.
